# Copy to .env and fill in. Leave the keys empty to run in offline template mode.
ANTHROPIC_API_KEY=

# Only for model.provider: openai_compatible in brand.yaml (the variable name is set by model.api_key_env).
# Local servers like Ollama don't need a key.
# OPENAI_API_KEY=

# Optional: path to a different brand voice file (default: brand.yaml)
# BRAND_CONFIG=brand.yaml

# Optional: live Google Business Profile (see README). Leave unset to use demo data.
# GOOGLE_CLIENT_SECRETS=client_secret.json
# GOOGLE_ACCOUNT_ID=
# GOOGLE_LOCATION_ID=
# GOOGLE_TOKEN_FILE=.google_token.json
